rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/game/current {
   allow read: if owner(uid);
   allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['schema','revision','payload','updatedAt'])
     && request.resource.data.schema == 1
     && request.resource.data.revision == 1
     && request.resource.data.payload is string
     && request.resource.data.payload.size() < 900000
     && request.resource.data.updatedAt == request.time;
   allow update: if owner(uid)
     && request.resource.data.keys().hasOnly(['schema','revision','payload','updatedAt'])
     && request.resource.data.schema == 1
     && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.payload is string
     && request.resource.data.payload.size() < 900000
     && request.resource.data.updatedAt == request.time;
  }
  match /users/{uid}/history/{record} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['type','year','payload'])
     && request.resource.data.type in ['wizards','athletes','items','timeline','matches','seasons','battles','events','conversations','honors']
     && request.resource.data.year is number
     && request.resource.data.payload is string
     && request.resource.data.payload.size() < 900000;
  }
 }
}
